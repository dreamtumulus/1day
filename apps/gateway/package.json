{
  "name": "@1dayapi/gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "1dayAPI inference gateway (local rebuild of api.wokey.ai)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mock:upstream": "node scripts/mock-upstream.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "tsc -p tsconfig.json && node --import ./test/setup.mjs --test test/*.test.mjs"
  },
  "dependencies": {
    "@1dayapi/catalog": "workspace:*",
    "fastify": "^5.0.0",
    "@1dayapi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

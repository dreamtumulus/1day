#!/usr/bin/env bash
# Post-release business verification (docs/operations.md §4): a release is done only when this passes.
#   ops/bin/release-verify            # on the main server, as root
# Checks: gateway health; one real claude-sonnet-5-5 request with the monitor's consumer key returns 200;
# the public pool has at least one online account (or the count did not drop vs. the saved baseline);
# nodes are online; one monitor run is green; device identities on every node match the registered ones (X-49).
# Exit non-zero on any failure.
set -uo pipefail
KEY=$(cat /root/monitor/apikey.txt 2>/dev/null || true)
fail=0
say() { printf '%s\n' "$*"; }
chk() { if "$@"; then say "  ok"; else say "  FAIL"; fail=1; fi; }

say "1. gateway /health"
chk curl -fsS -m 10 https://api.1dayapi.com/health >/dev/null

# 铁律 2 (docs/iron-rules.md): the canary group's key goes first when present, so a release is verified on the
# canary accounts before the general pool is touched by the monitor's key.
CKEY=$(cat /root/monitor/canary-apikey.txt 2>/dev/null || true)
if [ -n "$CKEY" ]; then
  say "2a. canary-group request (claude-sonnet-5-5, max_tokens 16)"
  ccode=$(curl -s -m 120 -o /tmp/release-verify-canary.json -w '%{http_code}' -X POST https://api.1dayapi.com/v1/messages \
    -H "authorization: Bearer $CKEY" -H 'content-type: application/json' -H 'anthropic-version: 2023-06-01' \
    -d '{"model":"claude-sonnet-5-5","max_tokens":16,"messages":[{"role":"user","content":"Reply with the single word OK."}]}')
  say "  HTTP $ccode $(head -c 160 /tmp/release-verify-canary.json)"
  [ "$ccode" = "200" ] || fail=1
fi
say "2. real request (claude-sonnet-5-5, max_tokens 16)"
if [ -n "$KEY" ]; then
  code=$(curl -s -m 120 -o /tmp/release-verify.json -w '%{http_code}' -X POST https://api.1dayapi.com/v1/messages \
    -H "authorization: Bearer $KEY" -H 'content-type: application/json' -H 'anthropic-version: 2023-06-01' \
    -d '{"model":"claude-sonnet-5-5","max_tokens":16,"messages":[{"role":"user","content":"Reply with the single word OK."}]}')
  say "  HTTP $code $(head -c 160 /tmp/release-verify.json)"
  [ "$code" = "200" ] || fail=1
else
  say "  SKIP (no /root/monitor/apikey.txt)"; fail=1
fi

say "3. public pool online accounts"
pool=$(curl -fsS -m 10 http://127.0.0.1:8401/api/pool || echo '{}')
online=$(printf '%s' "$pool" | python3 -c 'import json,sys; d=json.load(sys.stdin).get("data",{}).get("totals",{}); print(d.get("online",0))' 2>/dev/null || echo 0)
base_file=/opt/1dayapi/data/release-verify-baseline
base=$(cat "$base_file" 2>/dev/null || echo 0)
say "  online=$online baseline=$base"
if [ "$online" -ge 1 ] && [ "$online" -ge "$base" ]; then say "  ok"; else say "  FAIL"; fail=1; fi
[ "$online" -gt "$base" ] && echo "$online" > "$base_file"

say "4. nodes online"
nodes=$(curl -fsS -m 10 http://127.0.0.1:8401/api/pool >/dev/null && node --no-warnings -e "import('node:sqlite').then(({DatabaseSync})=>{const db=new DatabaseSync('/opt/1dayapi/data/1dayapi.db',{readOnly:true});const r=db.prepare(\"select count(*) n from nodes where online=1 and last_heartbeat_at>=strftime('%Y-%m-%dT%H:%M:%SZ','now','-2 minutes')\").get();console.log(r.n)})")
say "  fresh heartbeats: $nodes"
[ "${nodes:-0}" -ge 2 ] || fail=1

say "5. monitor run"
if (cd /root/monitor && timeout 300 python3 func.py > /tmp/release-verify-monitor.log 2>&1); then
  out=$(grep -m1 '^20' /tmp/release-verify-monitor.log)
  say "  $out"
  printf '%s' "$out" | grep -q 'false' && { say "  FAIL (a probe failed)"; fail=1; }
else
  say "  FAIL (monitor did not run: $(tail -1 /tmp/release-verify-monitor.log))"; fail=1
fi

say "6. device identity (X-49): every account's .claude.json userID = accounts.device_id, owned by its worker uid"
if out=$(/opt/1dayapi/ops/bin/device-identity-check 2>&1); then
  printf '%s\n' "$out" | sed 's/^/  /'
else
  printf '%s\n' "$out" | sed 's/^/  /'; say "  FAIL (device identity drift)"; fail=1
fi

if [ "$fail" = 0 ]; then
  say "RELEASE VERIFIED"
else
  say "RELEASE NOT VERIFIED"
  # A failed verification is a decision point, not a log line: say exactly how to go back.
  GS=$(cd "$(dirname "$0")" && pwd)/gateway-switch
  say ""
  say "To roll the gateway back to the previous instance:"
  say "    $GS --rollback"
  say "  - previous instance still running (released with --hold): nginx goes back to it at once, old code, no restart;"
  say "  - previous instance draining: wait for the drain, or add --force-restart (cuts its in-flight streams);"
  say "  - previous instance stopped: it is started on the build on disk, so restore the previous build FIRST"
  say "    (docs/operations.md §4: git checkout <previous commit> && pnpm install --frozen-lockfile && pnpm build,"
  say "     or repoint /opt/1dayapi-releases/current), then run the command above."
  say "Current state: $("$GS" --status 2>/dev/null | tr '\n' ' ')"
  say "Failures in steps 3-6 (pool, nodes, monitor, device identity) may be unrelated to the gateway build: read them before rolling back."
fi
exit $fail
